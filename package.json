{
  "name": "dom",
  "productName": "DOM",
  "version": "0.5.5",
  "description": "DOM v0.5.5, simultaneous multi-keyword desktop application",
  "author": "DOM",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check-source.cjs",
    "recover": "node scripts/recover.cjs",
    "package:linux": "npm run check && electron-builder --linux AppImage tar.gz --x64 --publish never",
    "package:windows": "npm run check && electron-builder --win nsis --x64 --publish never --config.directories.output=release-windows",
    "benchmark": "node scripts/benchmark.cjs"
  },
  "devDependencies": {
    "@electron/asar": "3.2.10",
    "7zip-bin": "5.2.0",
    "electron": "31.2.1",
    "electron-builder": "24.13.3",
    "playwright-core": "1.62.1"
  },
  "build": {
    "appId": "com.dom.desktop",
    "productName": "DOM",
    "asar": true,
    "directories": {
      "output": "release-linux"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "src/renderer/**/*",
      "src/shared/**/*",
      "src/proxy/AllWorkingProxyProvider.js",
      "src/proxy/ProxyParser.js",
      "third-party/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Utility",
      "artifactName": "DOM-v${version}-linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "DOM-v${version}-Windows-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DOM"
    }
  },
  "linuxRelease": "v0.5.5-linux.1",
  "windowsRelease": "v0.5.5"
}
